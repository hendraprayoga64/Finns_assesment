PORT=3100
IOT_API_KEY=change-me-static-camera-api-key
FLUSH_INTERVAL_MS=60000
BATCH_SIZE=500
BUFFER_DB_PATH=./iot-buffer.db
# mock = append to ./bq-mock.jsonl ; live = real BigQuery
BQ_MODE=mock
GCP_PROJECT=my-project
BQ_DATASET=hospitality_dw
BQ_TABLE=fact_iot_camera_events
# live mode: path to the Workload Identity Federation credential config (NOT a key file)
# GOOGLE_APPLICATION_CREDENTIALS=/etc/edge-middleware/wif-credential-config.json
