[Unit]
Description=Edge Middleware - IoT People Count Receiver
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=edgeapp
Group=edgeapp
WorkingDirectory=/opt/edge-middleware/edge-iot-receiver
EnvironmentFile=/etc/edge-middleware/iot.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/var/log/edge-iot.log
StandardError=append:/var/log/edge-iot.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/edge-middleware/edge-iot-receiver /var/log

[Install]
WantedBy=multi-user.target
