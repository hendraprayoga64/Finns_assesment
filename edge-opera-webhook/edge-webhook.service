[Unit]
Description=Edge Middleware - Opera PMS Webhook
After=network-online.target
Wants=network-online.target
# Stop crash-looping forever: max 10 restarts per 5 minutes, then mark failed.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=edgeapp
Group=edgeapp
WorkingDirectory=/opt/edge-middleware/edge-opera-webhook
EnvironmentFile=/etc/edge-middleware/opera.env
ExecStart=/usr/bin/node server.js

# Restart on crash / non-zero exit / signal / timeout (not on a clean `systemctl stop`)
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# App logs (stdout/stderr) go to the file we later grep
StandardOutput=append:/var/log/edge-webhook.log
StandardError=append:/var/log/edge-webhook.log

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/edge-middleware/edge-opera-webhook /var/log

[Install]
# Start on boot
WantedBy=multi-user.target
